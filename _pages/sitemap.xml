---
layout: none
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/search/</loc></url>
  {%- for cat in site.data.navigation.categories %}
  <url><loc>{{ site.url }}/{{ cat.slug }}/</loc></url>
  {%- endfor %}
  {%- for doc in site.data.registry_catalog.items %}
  <url><loc>{{ site.url }}{{ doc.url }}</loc>{% if doc.date %}<lastmod>{{ doc.date }}</lastmod>{% endif %}</url>
  {%- endfor %}
</urlset>
