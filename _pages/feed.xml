---
layout: none
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ site.url }}/feed.xml</id>
  <title>{{ site.title | escape }}</title>
  <subtitle>{{ site.description | escape }}</subtitle>
  <updated>{{ site.data.registry_catalog.generated_at | default: site.time | date_to_xmlschema }}</updated>
  <link rel="self" href="{{ site.url }}/feed.xml" type="application/atom+xml"/>
  <link rel="alternate" href="{{ site.url }}/" type="text/html"/>
  <author>
    <name>{{ site.author | escape }}</name>
    <email>{{ site.email | escape }}</email>
  </author>
  {%- assign items = site.data.registry_catalog.items | sort: "date" | reverse %}
  {%- for doc in items limit: 50 %}
  {%- assign updated = doc.provenance.built_at | default: doc.date %}
  <entry>
    <id>{{ site.url }}{{ doc.url }}</id>
    <title>{{ doc.id | escape }} — {{ doc.title | escape }}</title>
    <link rel="alternate" href="{{ site.url }}{{ doc.url }}" type="text/html"/>
    {%- if doc.date %}
    <published>{{ doc.date | date_to_xmlschema }}</published>
    {%- endif %}
    {%- if updated %}
    <updated>{{ updated | date_to_xmlschema }}</updated>
    {%- endif %}
    {%- if doc.abstract %}
    <summary>{{ doc.abstract | escape }}</summary>
    {%- endif %}
    {%- if doc.doctype %}
    <category term="{{ doc.doctype | escape }}"/>
    {%- endif %}
    {%- if doc.stage %}
    <category term="{{ doc.stage | escape }}"/>
    {%- endif %}
    {%- for f in doc.files %}
    <link rel="enclosure" href="{{ site.url }}{{ f.url }}" type="{{ f.media_type }}" length="{{ f.bytes }}"/>
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
