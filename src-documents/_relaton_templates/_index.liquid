<!DOCTYPE html>
<html lang="{{ lang | default: "en" }}" class="">

  {% render 'head' %}

  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-indigo-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      Skip to main content
    </a>

    {% render 'header' %}

    <main id="main-content" class="pt-16">
      <!-- Hero section -->
      <div class="hero-section">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
          {% if title %}
          <div class="hero-content">
            <h1 class="hero-title">{{ title }}</h1>
            <p class="hero-subtitle">
              Browse and search {{ title | downcase | remove: 'calconnect ' }} published by CalConnect.
            </p>
          </div>
          {% endif %}

          <!-- Search bar -->
          <div class="search-bar-wrap">
            <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="doc-search" class="search-input" placeholder="Search by title, identifier, or keyword…">
            <kbd class="search-kbd">/</kbd>
          </div>

          <!-- Filter tabs (populated by JS) -->
          <div id="filter-tabs" class="filter-tabs"></div>
        </div>
      </div>

      <!-- Document list -->
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        <div class="doc-list-header">
          <span id="doc-count" class="doc-count-text"></span>
        </div>
        <div id="doc-list" class="doc-list">
          {% render 'document' for documents %}
        </div>
        <div id="no-results" class="no-results hidden">
          <svg class="no-results-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
          <p class="no-results-text">No documents match your search.</p>
          <button onclick="clearSearch()" class="no-results-clear">Clear search</button>
        </div>
      </div>
    </main>

    {% render 'footer' %}

    {% render 'script' %}
  </body>

</html>
