---
// Category/listing layout (doc-type equivalent): hero, search, stage
// filter tabs, toolbar, document cards — all client-filterable without
// the JS bundle (cards are server-rendered).
import Base from "./Base.astro";
import DocumentCard from "../components/DocumentCard.astro";
import { type Doc } from "../lib/registry";

interface Props {
  title: string;
  activeSlug?: string;
  docs: Doc[];
  subtitleHint?: string;
  description?: string;
}
const { title, activeSlug, docs, subtitleHint, description } = Astro.props;
const head = "";
---
<Base title={title} description={description} activeSlug={activeSlug} head={head}>
  <div class="hero-section">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <div class="hero-content">
        <h1 class="hero-title">{title}</h1>
        <p class="hero-subtitle">{description ?? `Browse and search ${subtitleHint ?? title.toLowerCase()} published by ${site.publisher}.`}</p>
      </div>
      {docs.length > 0 && (
        <div class="search-bar-wrap">
          <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          <input type="text" id="doc-search" class="search-input" placeholder="Search by title, identifier, or keyword…" />
          <kbd class="search-kbd">/</kbd>
        </div>
      )}
      {docs.length > 0 && <div id="filter-tabs" class="filter-tabs"></div>}
    </div>
  </div>

  {docs.length > 0 && (
    <div id="doc-toolbar" class="doc-toolbar">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="toolbar-inner">
          <span id="doc-count" class="doc-count-text"></span>
          <div class="toolbar-controls">
            <select id="sort-select" class="sort-select">
              <option value="id-asc">Identifier A-Z</option>
              <option value="id-desc">Identifier Z-A</option>
              <option value="date-desc" selected>Newest first</option>
              <option value="date-asc">Oldest first</option>
              <option value="title-asc">Title A-Z</option>
            </select>
            <div class="view-toggle" role="group" aria-label="View mode">
              <button id="view-cards" class="view-btn active" aria-label="Card view" aria-pressed="true">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" stroke-width="2" /><rect x="14" y="3" width="7" height="7" rx="1" stroke-width="2" /><rect x="3" y="14" width="7" height="7" rx="1" stroke-width="2" /><rect x="14" y="14" width="7" height="7" rx="1" stroke-width="2" /></svg>
              </button>
              <button id="view-compact" class="view-btn" aria-label="List view" aria-pressed="false">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    {docs.length > 0 ? (
      <>
        <div id="doc-list" class="doc-list">
          {docs.map((doc) => <DocumentCard doc={doc} />)}
        </div>
        <div id="no-results" class="no-results hidden">
          <svg class="no-results-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 0114 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
          <p class="no-results-text">No documents match your search.</p>
          <button onclick="clearSearch()" class="no-results-clear">Clear search</button>
        </div>
      </>
    ) : (
      <div class="empty-state">
        <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
        <p class="empty-state-text">No documents found.</p>
      </div>
    )}
  </div>
  <script is:inline src="/js/document-list.js"></script>
</Base>
