---
// Base layout: head (meta, fonts, endpoints), header, footer, scripts.
// Ported from the theme's base layout + instance head/header/footer.
import "../styles/global.css";
import { site, categories, branding, base, withBase } from "../lib/registry";

interface Props {
  title?: string;
  description?: string;
  activeSlug?: string;
}
const { title, description, activeSlug } = Astro.props;
const fullTitle = title ? `${site.title}: ${title}` : site.title;
const rbJson = JSON.stringify(base);
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description ?? site.description ?? site.title} />
  <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  <link rel="icon" type="image/png" sizes="96x96" href={withBase("/favicon-96x96.png")} />
  <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico")} />
  <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
  <link rel="manifest" href={withBase("/site.webmanifest")} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    html{scroll-behavior:smooth!important}
    body{font-feature-settings:"kern" 1,"liga" 1;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;background-color:#fff!important;color:#1e293b!important;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,sans-serif!important;opacity:1!important}
    html.dark body{background-color:#0f172a!important;color:#f1f5f9!important}
    #nav-header{position:fixed!important;top:0!important;left:0!important;right:0!important;z-index:50!important;height:64px!important}
    main{padding-top:64px!important}
  </style>
  <link rel="search" type="application/opensearchdescription+xml" href={withBase("/opensearch.xml")} title={site.title} />
  <link rel="alternate" type="application/atom+xml" title={`${site.title} feed`} href={withBase("/feed.xml")} />
  <slot name="head" />
</head>
<body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-white">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-indigo-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">Skip to main content</a>

  <header id="nav-header" class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-gray-950/95 backdrop-blur-md border-b border-gray-200 dark:border-white/10 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-3">
          <a href={withBase("/")} class="flex items-center" aria-label={site.publisher}>
            <img src={withBase(branding.logo_light)} alt={site.publisher} class="h-8 block dark:hidden" />
            <img src={withBase(branding.logo_dark)} alt={site.publisher} class="h-8 hidden dark:block" />
          </a>
          <span class="hidden sm:block text-sm font-medium text-gray-400 dark:text-gray-500">|</span>
          <a href={withBase("/")} class="hidden sm:block text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors">Document Registry</a>
        </div>
        <nav class="hidden lg:flex items-center gap-0.5" aria-label="Main navigation">
          {categories.map((cat) => (
            <a href={withBase(`/${cat.slug}/`)} class:list={["nav-link", cat.display_category_slug === activeSlug && "nav-active"]}>{cat.title}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <button id="theme-toggle" class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle dark mode">
            <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </button>
          <button id="mobile-menu-toggle" class="lg:hidden p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle menu" aria-expanded="false">
            <svg class="w-6 h-6 menu-closed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg class="w-6 h-6 menu-open hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>
    </div>
    <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 dark:border-white/10 bg-white dark:bg-gray-950">
      <div class="max-w-7xl mx-auto px-4 py-3 space-y-1">
        {categories.map((cat) => <a href={withBase(`/${cat.slug}/`)} class="mobile-nav-link">{cat.title}</a>)}
        <div class="mobile-nav-divider"></div>
        <a href={withBase("/patents/")} class="mobile-nav-link">Patent DB</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="bg-gray-50 dark:bg-gray-950 border-t border-gray-200 dark:border-white/10 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Documents</h4>
          <ul class="space-y-2">
            {categories.map((cat) => (
              <li><a href={withBase(`/${cat.slug}/`)} class="text-sm text-gray-600 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400">{cat.title}</a></li>
            ))}
            <li><a href={withBase("/public-review/")} class="text-sm text-gray-600 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400">Public Review</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Community</h4>
          <ul class="space-y-2">
            {branding.footer.community.map((l) => <li><a href={l.url} class="text-sm text-gray-600 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400">{l.text}</a></li>)}
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Resources</h4>
          <ul class="space-y-2">
            {branding.footer.resources.map((l) => <li><a href={l.url} class="text-sm text-gray-600 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400">{l.text}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="mt-8 pt-8 border-t border-gray-200 dark:border-white/10">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Copyright &copy; {year} <a href={branding.copyright_url} class="hover:text-gray-700 dark:hover:text-gray-300">{branding.copyright_name}</a><sup>SM</sup>
        </p>
      </div>
    </div>
  </footer>

  <script is:inline set:html={`window.RB = ${rbJson}`} />
  <script is:inline src={withBase("/js/theme.js")}></script>
  <script is:inline src={withBase("/js/navigation.js")}></script>
</body>
</html>
